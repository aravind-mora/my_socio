# SocioSphere Frontend environment variables
# Copy this file to `.env` and fill in your values.

# Base URL of the SocioSphere backend (Node server on port 5000)
VITE_API_URL=http://localhost:5000

# Public URL of this frontend
VITE_FRONTEND_URL=http://localhost:5173

# Optional: dev proxy target used by vite.config.js (overrides VITE_API_URL for /api calls in dev)
# VITE_PROXY_TARGET=http://localhost:5000
