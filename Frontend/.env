# ============================================================
# SocioSphere Frontend — runtime configuration
# This file controls which backend the frontend talks to and
# which URL is treated as "this frontend" (used by Google OAuth
# and the CORS allowlist on the backend).
# ============================================================

# ----- BACKEND URL -----
# Where the SocioSphere Node backend is running.
#   Local dev:   http://localhost:5000
#   Deployed:    https://your-backend.onrender.com   (or wherever you host it)
VITE_API_URL=http://localhost:5000

# ----- FRONTEND URL -----
# The public URL of THIS frontend (used for Google OAuth redirects
# and must match the FRONTEND_URL inside the backend's .env).
#   Local dev:   http://localhost:5173
#   Deployed:    https://sociosphere-zeta.vercel.app
VITE_FRONTEND_URL=http://localhost:5173

# ----- DEV PROXY TARGET (optional) -----
# In `npm run dev`, /api/* calls are proxied to this target.
# Leave empty to use VITE_API_URL. If you set VITE_API_URL to a
# deployed backend you can keep this empty — axios will call it directly.
# VITE_PROXY_TARGET=http://localhost:5000
